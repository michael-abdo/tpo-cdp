{
  // UI render tests (test/ui/): the React screens are typed against the DOM and JSX, which the worker
  // project (tsconfig.worker.json, the rest of test/) must not see. They still run in workerd (vitest.config.ts).
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.ui-test.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["test/ui"]
}
