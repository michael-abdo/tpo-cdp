// Cloudflare Worker config — design: 03 §Module layout, 11 §Deploy.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tpo-cdp",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // The SPA is served from static assets; the Worker runs first only for API, webhook and health paths.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/webhooks/*", "/health"]
  },

  // D1 is the only data store (01). database_id is filled after `wrangler d1 create cdp` (11 §Deploy);
  // local dev and tests use a local SQLite file and ignore the id.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cdp",
      "database_id": "750e1409-0cb4-4a97-9f53-514367126e0a",
      "migrations_dir": "migrations"
    }
  ],

  // Rate limits (04 §Auth), each keyed by CF-Connecting-IP. Workers Rate Limiting only supports
  // 10 s or 60 s periods; the assistant's hourly limit is enforced from ai_audit rows, per session
  // and per client (ai_audit.client_key, migrations/0005), and ASSISTANT_LIMITER adds a per-IP
  // burst limit; a new session resets neither (09 D-70 #6). TEST_EVENT_LIMITER is the "Send a
  // test event" panel's own limit (09 D-73): keyed by client, not session, same D-70 #6 style.
  // APPROVAL_LIMITER (09 D-64b) is the second shared password's own limit, the same shape as
  // LOGIN_LIMITER: any signed-in session could otherwise brute-force TOOL_APPROVAL at will.
  "ratelimits": [
    { "name": "WEBHOOK_LIMITER", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } },
    { "name": "LOGIN_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
    { "name": "ASSISTANT_LIMITER", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } },
    { "name": "EXPORT_LIMITER", "namespace_id": "1004", "simple": { "limit": 10, "period": 60 } },
    { "name": "TEST_EVENT_LIMITER", "namespace_id": "1005", "simple": { "limit": 20, "period": 60 } },
    { "name": "APPROVAL_LIMITER", "namespace_id": "1006", "simple": { "limit": 10, "period": 60 } }
  ]
}
