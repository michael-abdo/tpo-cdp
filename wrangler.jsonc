// Cloudflare Worker config: one Worker serves the API, the webhook and the static SPA.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tpo-cdp",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // The SPA is served from static assets; the Worker runs first only for API, webhook and health paths.
  // Static files take their security and cache headers from public/_headers; the Worker sets the
  // same security headers, no-store and the https rule on its own answers (worker/http-hardening.ts).
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/webhooks/*", "/health"]
  },

  // D1 is the only data store. database_id is filled after `wrangler d1 create cdp`;
  // local dev and tests use a local SQLite file and ignore the id.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cdp",
      "database_id": "750e1409-0cb4-4a97-9f53-514367126e0a",
      "migrations_dir": "migrations"
    }
  ],

  // Rate limits, each keyed by CF-Connecting-IP. Workers Rate Limiting only supports
  // 10 s or 60 s periods; the assistant's hourly limit is enforced from ai_audit rows, per session
  // and per client (ai_audit.client_key, migrations/0005), and ASSISTANT_LIMITER adds a per-IP
  // burst limit; a new session resets neither, so signing in again buys no extra calls.
  // TEST_EVENT_LIMITER is the "Send a test event" panel's own limit: keyed by client, not session,
  // for the same reason.
  "ratelimits": [
    { "name": "WEBHOOK_LIMITER", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } },
    { "name": "LOGIN_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
    { "name": "ASSISTANT_LIMITER", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } },
    { "name": "EXPORT_LIMITER", "namespace_id": "1004", "simple": { "limit": 10, "period": 60 } },
    { "name": "TEST_EVENT_LIMITER", "namespace_id": "1005", "simple": { "limit": 20, "period": 60 } }
  ]
}
